# ==============================================================================
# GitHub Terraform Configuration - Example Variables
# Copy to terraform.tfvars (gitignored) for local planning or export via ENV:
# export GITHUB_TOKEN="ghp_xxxxxxxxxxxx"
# ==============================================================================

github_owner          = "bar2sek"
repository_name       = "infra-cloud-deployments"
repository_visibility = "private"

# Escape hatch for a deliberate history rewrite. Branch protection rejects
# force-pushes to `main` with GH006 even for admins. Set true, apply, push,
# then set back to false and re-apply. Leave false during normal operation.
# allow_force_push_main = false

# Azure OIDC Federation Parameters (retrieved from 'bootstrap/azure' outputs):
# azure_client_id       = "00000000-0000-0000-0000-000000000000"
# azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
# azure_subscription_id = "00000000-0000-0000-0000-000000000000"

# AWS OIDC Federation Parameters (retrieved from 'bootstrap/aws' outputs).
# Both of these embed the AWS account ID — keep them out of version control.
# All three are published as masked Actions SECRETS. An ARN grants nothing on
# its own, but GitHub prints step inputs and `run:` commands verbatim into the
# publicly readable workflow logs, and the account ID must not appear there.
# aws_role_arn        = "arn:aws:iam::000000000000:role/role-aws-github-actions-prod-001" # apply (production env)
# aws_plan_role_arn   = "arn:aws:iam::000000000000:role/role-aws-github-plan-prod-001"    # plan (pull requests)
# aws_region          = "us-east-2"
# aws_tf_state_bucket = "s3-aws-tfstate-prod-use2-000000000000"

# Cloudflare Parameters for Multi-Cloud GitOps Runner:
# cloudflare_account_id        = "your-cloudflare-account-id"
# cloudflare_zone_id           = "your-cloudflare-zone-id"
# cloudflare_destination_email = "user@example.com"
# cloudflare_api_token         = "your-cloudflare-api-token"

# Microsoft Entra ID (Azure AD) Parameters for Cloudflare Access IdP:
# entra_client_id              = "00000000-0000-0000-0000-000000000000"
# entra_tenant_id              = "00000000-0000-0000-0000-000000000000"
# entra_client_secret          = "your-entra-client-secret-value"
