# ==============================================================================
# Azure & Entra ID Homelab - Terraform Variables Example
# Copy to terraform.tfvars (gitignored) and fill in real values.
# ==============================================================================

# Identity platform subscription (default provider) and management platform
# subscription (remote-state account). `az account list -o table` lists them.
subscription_id            = "00000000-0000-0000-0000-000000000000"
management_subscription_id = "00000000-0000-0000-0000-000000000000"

# Your Microsoft Entra ID Tenant ID (from Entra Admin Center or `az account show`)
tenant_id = "00000000-0000-0000-0000-000000000000"

# Target deployment region & standardized short code
location       = "centralus"
location_short = "cus"

# Standard core 3 node descriptors
platform  = "azure"
product   = "homelab"
env       = "prod"
iteration = "001"

# Inbound OIDC callback URL for Authentik running on your Talos cluster
authentik_redirect_uri = "https://auth.bar2sek.com/source/oauth/callback/entra-id/"

# Budget + cost-anomaly alert recipients (personal data: tfvars only, never git)
alert_emails = ["you@example.com"]

# Optional: budget overrides (USD/month) keyed by the <category> name node; others use
# default_monthly_budget_by_env (prod 5, nonprod 5, lab 3)
# monthly_budgets = {
#   connectivity = 15
#   management   = 10
# }
