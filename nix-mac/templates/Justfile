# ==============================================================================
# Mac AI Workstation - Command Runner (just)
# ==============================================================================

# Default command: List available recipes
default:
    @just --list

# ------------------------------------------------------------------------------
# Nix-Darwin & Home Manager System Management
# ------------------------------------------------------------------------------

# Sync canonical templates from the Second Brain vault into ~/.config/nix-darwin
sync:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    Matches=("$HOME"/Library/CloudStorage/GoogleDrive-*/"My Drive"/second-brain/personal-technology/nix-mac/templates)
    shopt -u nullglob
    if [ ${#Matches[@]} -gt 0 ] && [ -d "${Matches[0]}" ]; then
      TPL="${Matches[0]}"
      mkdir -p "$HOME/.config/nix-darwin"
      cp "$TPL/flake.nix" "$TPL/darwin.nix" "$TPL/home.nix" "$TPL/Justfile" "$TPL/p10k.zsh" "$TPL/flake.lock" "$HOME/.config/nix-darwin/"
      echo "✅ Synced nix-mac templates -> ~/.config/nix-darwin/"
    else
      echo "ℹ️  Vault templates directory not found; using existing ~/.config/nix-darwin/"
    fi

# Sync templates, rebuild, and apply the nix-darwin + home-manager configuration
switch: sync
    sudo -H darwin-rebuild switch --flake ~/.config/nix-darwin#MacBook-Pro

# Update nix flake lockfile, sync it back to the vault repo, and apply
update: sync
    #!/usr/bin/env bash
    set -euo pipefail
    nix flake update --flake "$HOME/.config/nix-darwin"
    shopt -s nullglob
    Matches=("$HOME"/Library/CloudStorage/GoogleDrive-*/"My Drive"/second-brain/personal-technology/nix-mac/templates)
    shopt -u nullglob
    if [ ${#Matches[@]} -gt 0 ] && [ -d "${Matches[0]}" ]; then
      cp "$HOME/.config/nix-darwin/flake.lock" "${Matches[0]}/flake.lock"
      echo "✅ Synced updated flake.lock -> nix-mac/templates/flake.lock"
    fi
    sudo -H darwin-rebuild switch --flake "$HOME/.config/nix-darwin#MacBook-Pro"

# Garbage collect old Nix generations to free disk space
gc:
    nix-collect-garbage -d

# ------------------------------------------------------------------------------
# Local LLM Serving (Apple MLX via uvx - Zero Bloat)
# ------------------------------------------------------------------------------

# Launch Qwen 2.5 Coder 32B (4-bit) MLX Server for Roo Code chat & refactoring (port 8080)
serve-qwen-32b:
    uvx --from mlx-lm mlx_lm.server \
      --model mlx-community/Qwen2.5-Coder-32B-Instruct-4bit \
      --port 8080

# Quick CLI prompt test against local Qwen 32B via MLX
test-prompt:
    uvx --from mlx-lm mlx_lm.generate \
      --model mlx-community/Qwen2.5-Coder-32B-Instruct-4bit \
      --prompt "Write a Python script that benchmarks GPU memory bandwidth on Apple Silicon."

# ------------------------------------------------------------------------------
# Workspace & IDE Shortcuts
# ------------------------------------------------------------------------------

# Launch Antigravity Desktop app on the current directory
agy-app:
    open -a Antigravity .

# Launch Antigravity CLI in current terminal
agy:
    agy

# Prevent Mac from sleeping during long-running tasks
agy-awake:
    caffeinate -s

# Launch Visual Studio Code on current directory
code:
    code .

# ------------------------------------------------------------------------------
# System Housekeeping & Anti-Bloat
# ------------------------------------------------------------------------------

# Purge all system, package, and container caches
prune-all:
    uv cache clean
    nix-collect-garbage -d
    brew cleanup --prune=all
    @if command -v docker > /dev/null; then docker system prune -a --volumes -f; fi

# Explicitly purge heavy Apple consumer apps, audio libraries (~5-8GB), and thin APFS snapshots
debloat:
    @echo "Purging GarageBand, iMovie, sound libraries, and diagnostic logs..."
    @sudo rm -rf /Applications/GarageBand.app /Applications/iMovie.app 2>/dev/null || true
    @sudo rm -rf "/Library/Application Support/GarageBand" "/Library/Application Support/Logic" "/Library/Audio/Apple Loops" 2>/dev/null || true
    @rm -rf "$HOME/Library/Logs/DiagnosticReports"/* 2>/dev/null || true
    @sudo tmutil thinlocalsnapshots / 9999999999 4 2>/dev/null || true
    @echo "Done! Disk space reclaimed."

# ------------------------------------------------------------------------------
# Homelab & Kubernetes Cluster Shortcuts (Talos + UniFi + AWS)
# ------------------------------------------------------------------------------

# Launch k9s Kubernetes TUI dashboard
k9s:
    k9s

# Check Talos Linux HA control plane health (sm-node-01, 02, 03)
talos-health:
    talosctl --nodes 10.10.20.10,10.10.20.11,10.10.20.12 health

# List Kubernetes nodes across the homelab cluster
k8s-nodes:
    kubectl get nodes -o wide

# Check all running pods across all namespaces
k8s-pods:
    kubectl get pods -A -o wide
