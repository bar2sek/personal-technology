# ==============================================================================
# Mac AI Workstation - Command Runner (just)
# ==============================================================================

# Default command: List available recipes
default:
    @just --list

# ------------------------------------------------------------------------------
# Nix-Darwin System Management
# ------------------------------------------------------------------------------

# Rebuild and apply the nix-darwin configuration
switch:
    sudo -H darwin-rebuild switch --flake ~/.config/nix-darwin#MacBook-Pro

# Update nix flake lockfile to latest package versions
update:
    nix flake update --flake ~/.config/nix-darwin
    sudo -H darwin-rebuild switch --flake ~/.config/nix-darwin#MacBook-Pro

# Garbage collect old Nix generations to free disk space
gc:
    nix-collect-garbage -d

# ------------------------------------------------------------------------------
# Workspace & IDE Shortcuts
# ------------------------------------------------------------------------------

# Launch Antigravity Desktop app on the current directory
agy-app:
    open -a Antigravity .

# Launch Antigravity IDE on the current directory
agy-ide:
    open -a "Antigravity IDE" .

# Launch Antigravity CLI in current terminal
agy:
    agy

# Prevent Mac from sleeping during long-running tasks
agy-awake:
    caffeinate -s

# Launch Antigravity IDE (alias for code)
code:
    open -a "Antigravity IDE" .

# ------------------------------------------------------------------------------
# System Housekeeping & Anti-Bloat
# ------------------------------------------------------------------------------

# Purge all system, package, and container caches
prune-all:
    uv cache clean
    nix-collect-garbage -d
    brew cleanup --prune=all
    @if command -v docker > /dev/null; then docker system prune -a --volumes -f; fi

# Explicitly purge heavy Apple consumer apps and audio libraries (~5-8GB)
debloat:
    @echo "Purging GarageBand, iMovie, and sound libraries..."
    @sudo rm -rf /Applications/GarageBand.app /Applications/iMovie.app 2>/dev/null || true
    @sudo rm -rf "/Library/Application Support/GarageBand" "/Library/Application Support/Logic" "/Library/Audio/Apple Loops" 2>/dev/null || true
    @echo "Done! Disk space reclaimed."

# ------------------------------------------------------------------------------
# Homelab & Kubernetes Cluster Shortcuts (Talos + UniFi + AWS)
# ------------------------------------------------------------------------------

# Launch k9s Kubernetes TUI dashboard
k9s:
    k9s

# Check Talos Linux HA control plane health (sm-node-01, 02, 03)
talos-health:
    talosctl --nodes 10.10.20.10,10.10.20.11,10.10.20.12 health

# List Kubernetes nodes across the homelab cluster
k8s-nodes:
    kubectl get nodes -o wide

# Check all running pods across all namespaces
k8s-pods:
    kubectl get pods -A -o wide

# Connect to the remote Antigravity Dev Workspace on sm-node-03
ssh-dev:
    ssh antigravity-dev

