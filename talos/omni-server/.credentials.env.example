# Sidero Omni & Dex Admin Credentials Template
# Copy this file to .credentials.env and populate with your credentials.
# .credentials.env is strictly ignored by git to protect credentials.

OMNI_ADMIN_EMAIL="admin@omni.internal"
OMNI_ADMIN_PASSWORD="<REPLACE_WITH_STRONG_PASSWORD>"
OMNI_ADMIN_BCRYPT_HASH="<REPLACE_WITH_BCRYPT_HASH>"
OMNI_AUTH_CLIENT_SECRET="<REPLACE_WITH_RANDOM_SECRET>"
